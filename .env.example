# Copy this file to `.env` and fill in your real keys.
# Both keys are read at startup by python-dotenv.

# Required: Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY= your-anthropic-api-key-here


# Optional but strongly recommended: Tavily API key for high-quality web
# search. Without it the agent falls back to a DuckDuckGo HTML scrape,
# which is rate-limited and lower quality. Get one at https://tavily.com
TAVILY_API_KEY= your-tavily-api-key-here

# Optional: override the server bind address / port.
HOST=127.0.0.1
PORT=8000
